# Copy to .env and fill in real values before starting the proxy.

# Your OpenAI key — the ONE key that every device's requests get forwarded
# with. Stays on the server; never reaches a user's machine.
OPENAI_API_KEY=sk-...

# Random 32+ char string used to sign JWTs. Rotate to force every device
# to re-register. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Per-plan, per-device, per-calendar-day caps on chat completion calls.
# Embedding requests are NOT counted — they're bounded elsewhere.
FREE_DAILY=5
PRO_DAILY=25

# Per-plan, per-device, per-day caps on reorganization "starts".
FREE_REORG_DAILY=1
PRO_REORG_DAILY=5

# ── Google sign-in (account identity) ────────────────────────────────────────
# OAuth client of type "Desktop app" from Google Cloud Console. The CLIENT_ID is
# also baked into the desktop app (it's public); the SECRET stays here only — the
# proxy is what exchanges the auth code. Sign-in fails until both are set.
GOOGLE_CLIENT_ID=828216281643-8cavncibl3t9jmjonv41ln8nol6uvh9p.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Free trial for a signed-in account: chats/day and how long the trial lasts
# from first sign-in. Trial is chat-only (reorg blocked); after it lapses the
# account must upgrade to 'pro'.
TRIAL_DAILY=6
TRIAL_WINDOW_HOURS=24

# TEST ONLY — when '1', Google verification is stubbed (the auth code is decoded
# as base64url JSON instead of verified with Google). NEVER set in production.
# GOOGLE_AUTH_STUB=0

# Cost guardrails — the proxy only ever forwards these cheap models on your key,
# and clamps completion size, so a tampered client can't bill an expensive model.
CHAT_MODELS_ALLOWED=gpt-4o-mini
EMBED_MODELS_ALLOWED=text-embedding-3-small,text-embedding-3-large
MAX_COMPLETION_TOKENS=4096

# Abuse throttle: per-IP, per-day caps. Generous (whole offices / mobile networks
# share one IP) but enough to stop a script minting thousands of free devices.
REGISTER_IP_DAILY=20
PROXY_IP_DAILY=200

# Reverse-proxy hops to trust for the client IP. MUST be 1 (or your real hop
# count) in production behind nginx/Cloud Run, or every request looks like it
# comes from the load balancer and all users share one rate-limit bucket.
# Leave 0 for local/direct runs.
TRUST_PROXY=0

# How long each issued JWT stays valid. When this lapses the desktop app
# re-registers the same device transparently (no user interaction needed).
JWT_TTL_SECONDS=2592000

# HTTP port. 8787 is the default; the desktop app's config.properties uses it.
PORT=8787

# Where the SQLite DB lives. Relative paths resolve from the proxy dir.
# Persistent disk in your hosting setup.
DB_PATH=./shelfbot-proxy.db
