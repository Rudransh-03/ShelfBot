# Copy to .env and fill in real values before starting the proxy.

# Your OpenAI key — the ONE key that every user's requests get forwarded with.
# This stays on the server; it never reaches a user's machine.
OPENAI_API_KEY=sk-...

# Random 32+ char string used to sign JWTs. Rotate to force everyone to log
# back in. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Per-user, per-calendar-day cap on chat completion calls (the expensive ones).
# Embedding requests aren't counted — they're cheap and bounded by the indexer.
DAILY_QUERY_LIMIT=15

# How long each issued JWT stays valid. Users who let this lapse log back in.
JWT_TTL_SECONDS=2592000

# HTTP port. 8787 is the default; matches what the desktop app expects.
PORT=8787

# Where the user/usage SQLite DB lives. Relative paths resolve from the proxy
# directory. Persistent disk in your hosting setup.
DB_PATH=./shelfbot-proxy.db
