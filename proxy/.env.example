# Copy to .env and fill in real values before starting the proxy.

# Your OpenAI key — the ONE key that every device's requests get forwarded
# with. Stays on the server; never reaches a user's machine.
OPENAI_API_KEY=sk-...

# Random 32+ char string used to sign JWTs. Rotate to force every device
# to re-register. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Per-plan, per-device, per-calendar-day caps on chat completion calls.
# Embedding requests are NOT counted — they're bounded elsewhere.
FREE_DAILY=5
PRO_DAILY=25

# How long each issued JWT stays valid. When this lapses the desktop app
# re-registers the same device transparently (no user interaction needed).
JWT_TTL_SECONDS=2592000

# HTTP port. 8787 is the default; the desktop app's config.properties uses it.
PORT=8787

# Where the SQLite DB lives. Relative paths resolve from the proxy dir.
# Persistent disk in your hosting setup.
DB_PATH=./shelfbot-proxy.db
